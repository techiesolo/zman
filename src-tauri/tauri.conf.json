{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zman",
  "version": "0.1.0",
  "identifier": "com.techiesolo.zman",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "zman",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "frame-src": "'self' about: data:",
        "object-src": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg", "app"],
    "category": "DeveloperTool",
    "shortDescription": "Local-only API client",
    "longDescription": "An API client that keeps every collection, environment and request history on this computer. No account, no cloud, no telemetry.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.3",
      "signingIdentity": "-"
    }
  }
}
